# Public synthetic example only. Never put real credentials or identities here.
# The launcher reads root .env.dev, NOT .env or .env.example.
# Copy to .env.dev only if absent; otherwise merge deliberately without overwriting
# existing private values. Exported environment wins over .env.dev, even if empty.
# Use literal NAME=value lines; no export, interpolation or inline comments.

# Required backend settings. These match deploy/compose.dev.yaml's disposable DB.
# These credentials/storage are not suitable for real financial data.
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:54329/longnest_dev
SPRING_DATASOURCE_USERNAME=longnest_dev
SPRING_DATASOURCE_PASSWORD=longnest_dev_only
LONGNEST_LEDGER_OWNER=synthetic-dev-owner

# Optional. The dev launcher defaults to and requires exactly ledger, not dev.
SPRING_PROFILES_ACTIVE=ledger

# Optional Telegram. Live activation requires separate runtime authorization.
LONGNEST_TELEGRAM_ENABLED=false
# LONGNEST_TELEGRAM_TOKEN=REPLACE_WITH_BOTFATHER_TOKEN
# LONGNEST_TELEGRAM_USER=REPLACE_WITH_POSITIVE_NUMERIC_USER_ID

# Optional native DeepSeek conversation. No provider call or spend is authorized.
# Keep spring.ai.model.chat=none (the application's default); use this dedicated flag.
LONGNEST_DEEPSEEK_ENABLED=false
LONGNEST_DEEPSEEK_BASE_URL=https://api.deepseek.com
# LONGNEST_DEEPSEEK_API_KEY=REPLACE_WITH_PRIVATE_API_KEY
# LONGNEST_DEEPSEEK_MODEL=REPLACE_WITH_EXPLICIT_APPROVED_MODEL_ID
# Output tokens are unset: provider/model defaults apply, with variable length/cost.
# Legacy DEEPSEEK_MAX_TOKENS is not mapped; there is no replacement token-limit setting.

# The launcher builds/tests, ensures this local Compose DB is running/ready,
# migrates and prepares a fresh owner (or verifies the existing owner), then runs.
# URL must be exactly jdbc:postgresql://127.0.0.1:54329/NAME, with an ASCII identifier.
# Compose uses the same effective datasource user/password and derives NAME here.
# No reset/recreation; an existing container/owner mismatch fails.
